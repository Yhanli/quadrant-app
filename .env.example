# Supabase config — copy this file to `.env` and fill in your project's values.
# Find these in the Supabase dashboard under Project Settings → API.
# The anon/public key is safe to ship in a client app; your data is protected
# by Row Level Security, not by hiding this key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
